{
  "fixtures": [
    {
      "id": "phase2-trigger-draft-cli-page-ops",
      "prompt": "Use Draft CLI to list pages and read one page.",
      "assertions": [
        { "type": "trigger_decision", "expected": "activate" },
        {
          "type": "command_sequence",
          "target": "skill",
          "sequence": [
            "draft status --json",
            "draft start-server",
            "draft status --json"
          ]
        }
      ]
    },
    {
      "id": "phase2-nontrigger-generic-draft-verb",
      "prompt": "Draft an email to my customer.",
      "assertions": [
        { "type": "trigger_decision", "expected": "decline" }
      ]
    },
    {
      "id": "phase2-create-append-eval-present",
      "prompt": "Create and append to a page.",
      "assertions": [
        {
          "type": "command_contains",
          "target": "eval:create-and-append-with-connection-check:expected_output",
          "tokens": [
            "draft status --json",
            "draft page create --json",
            "draft page append --json"
          ]
        }
      ]
    }
  ]
