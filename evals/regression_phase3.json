    {
      "id": "phase3-bugfix-patch-safe-workflow-sequence",
      "title": "Bugfix regression guard: safe patch workflow steps are present in correct order",
      "scenario_class": "hard-pass",
      "scope": "regression",
      "prompt": "Apply a precise unified diff to my Draft page to change the first sentence of a paragraph.",
      "assertions": [
        {
          "type": "command_sequence",
          "target": "skill",
          "sequence": [
            "draft cat <id> | sed '1,4d' | sed '$d' > /tmp/before.md",
            "diff -u /tmp/before.md /tmp/after.md > /tmp/patch.diff ; cat /tmp/patch.diff | draft patch <id> --json"
          ]
        }
      ],
      "nondeterminism": {
        "mode": "deterministic",
        "reruns": 1
      },
      "tags": [
        "bugfix",
        "patch",
        "tc5"
      ],
      "source": "phase3-regression-corpus"
    },
