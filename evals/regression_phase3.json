      "title": "Normal trigger path stays active",
      "scenario_class": "hard-pass",
      "scope": "regression",
      "prompt": "I just set up Draft on my machine. Can you list all my pages and show me the contents of the most recent one in markdown format?",
      "assertions": [
        {
          "type": "artifact_exists",
          "path": "eval:list-and-cat-with-connection-check"
        },
        {
          "type": "command_sequence",
          "target": "eval:list-and-cat-with-connection-check:expectations",
          "sequence": [
            "draft status --json",
            "draft ls --json",
            "draft cat <id>"
          ]
        }
      ],
      "nondeterminism": {
        "mode": "deterministic",
        "reruns": 1
      },
      "tags": [
        "trigger",
        "normal",
        "e2e"
      ],
      "source": "phase3-regression-corpus"
    },
