{
  "fixtures": [
    {
      "id": "phase3-default-workspace-sequence",
      "title": "Default page operations anchor to workspace metadata first",
      "scenario_class": "hard-pass",
      "scope": "regression",
      "prompt": "Check the configured Draft workspace and then list pages.",
      "tags": ["workspace", "default-workspace"],
      "nondeterminism": { "mode": "deterministic", "reruns": 1 },
      "assertions": [
        { "type": "trigger_decision", "expected": "activate" },
        {
          "type": "text_contains",
          "target": "skill",
          "tokens": ["draft workspace status --json", "draft workspace path --json", "draft --workspace-json <active_workspace_path> page ls --json"]
        }
      ]
    },
    {
      "id": "phase3-explicit-workspace-override-guidance",
      "title": "Explicit workspace override stays documented for one-off reads and writes",
      "scenario_class": "hard-pass",
      "scope": "regression",
      "prompt": "How should I use Draft CLI with a different JSON Workspace folder for one command?",
      "tags": ["contract", "workspace-override"],
      "nondeterminism": { "mode": "deterministic", "reruns": 1 },
      "assertions": [
        {
          "type": "text_contains",
          "target": "skill",
          "tokens": [
            "draft --workspace-json <folder> page ls --json",
            "draft --workspace-json <folder> page create \"Title\" --json",
            "draft --workspace-json <folder> page append <page_id> \"More content\" --json"
          ]
        }
      ]
    },
    {
      "id": "phase3-set-workspace-path-guidance",
      "title": "Setting the default workspace path stays part of the contract",
      "scenario_class": "hard-pass",
      "scope": "regression",
      "prompt": "How do I make a JSON Workspace folder the default Draft workspace before editing pages?",
      "tags": ["contract", "workspace-set-path"],
      "nondeterminism": { "mode": "deterministic", "reruns": 1 },
      "assertions": [
        {
          "type": "text_contains",
          "target": "skill",
          "tokens": [
            "draft workspace set-path <folder> --json",
            "draft workspace status --json",
            "draft --workspace-json <folder> page create \"Title\" --json"
          ]
        }
      ]
    },
    {
      "id": "phase3-older-cli-fallback-guidance",
      "title": "Older CLI fallback prefers explicit workspace-json over daemon recovery",
      "scenario_class": "hard-pass",
      "scope": "regression",
      "prompt": "My Draft CLI does not support workspace commands. How should I keep working?",
      "tags": ["compatibility", "older-cli"],
      "nondeterminism": { "mode": "deterministic", "reruns": 1 },
      "assertions": [
        {
          "type": "text_contains",
          "target": "skill",
          "tokens": [
            "draft workspace --help",
            "draft --workspace-json <folder> page ls --json",
            "ask for the JSON Workspace folder path or ask them to upgrade the CLI"
          ]
        }
      ]
    },
    {
      "id": "phase3-secret-open-hosted-read",
      "title": "Secret Share reads skip workspace and daemon lifecycle",
      "scenario_class": "hard-pass",
      "scope": "regression",
      "prompt": "Read a Draft Secret Share link with a password.",
      "tags": ["secret-share", "hosted-read"],
      "nondeterminism": { "mode": "deterministic", "reruns": 1 },
      "assertions": [
        {
          "type": "text_contains",
          "target": "eval:secret-share-open-hosted-read:expected_output",
          "tokens": [
            "skips workspace and daemon lifecycle commands",
            "draft secret open",
            "--password '1234' --json"
          ]
        }
      ]
    },
    {
      "id": "phase3-patch-body-surface-guidance",
      "title": "Patch guidance uses body markdown instead of decorated cat output",
      "scenario_class": "hard-pass",
      "scope": "regression",
      "prompt": "How should I patch a Draft page in JSON Workspace without causing PATCH_MISMATCH?",
      "tags": ["contract", "patch", "json-workspace"],
      "nondeterminism": { "mode": "deterministic", "reruns": 1 },
      "assertions": [
        {
          "type": "text_contains",
          "target": "skill",
          "tokens": [
            "page body markdown only",
            "decorated human `page cat` output",
            "`page cat --json` block output",
            "regenerate a fresh diff against that exact body surface"
          ]
        },
        {
          "type": "text_contains",
          "target": "eval:patch-json-workspace-body-surface:expected_output",
          "tokens": [
            "extracts only the page body markdown",
            "does not build a diff from decorated page cat headers",
            "verifies the patch",
            "only then runs draft --workspace-json <active_workspace_path> page annotate"
          ]
        }
      ]
    },
    {
      "id": "phase3-image-local-id-guidance",
      "title": "Image mutation guidance carries insert-image local_id forward",
      "scenario_class": "hard-pass",
      "scope": "regression",
      "prompt": "How should I update and delete an image after inserting it with Draft CLI?",
      "tags": ["contract", "image", "json-workspace"],
      "nondeterminism": { "mode": "deterministic", "reruns": 1 },
      "assertions": [
        {
          "type": "text_contains",
          "target": "skill",
          "tokens": [
            "`draft page insert-image` returns `local_id`",
            "returned `local_id`",
            "identifier is exposed as the image block `id`"
          ]
        },
        {
          "type": "text_contains",
          "target": "eval:image-local-id-mutation-flow:expected_output",
          "tokens": [
            "captures the returned local_id",
            "page update-image <id> <local_id>",
            "page delete-image <id> <local_id>",
            "image block id as the same identifier"
          ]
        }
      ]
    },
    {
      "id": "phase3-public-preview-feedback-direct-read",
      "title": "Public preview feedback reads use comments_api_url directly",
      "scenario_class": "hard-pass",
      "scope": "regression",
      "prompt": "Read feedback from this Draft public preview URL.",
      "tags": ["public-preview", "feedback", "hosted-read"],
      "nondeterminism": { "mode": "deterministic", "reruns": 1 },
      "assertions": [
        {
          "type": "text_contains",
          "target": "skill",
          "tokens": [
            "Public Preview Feedback",
            "comments_api_url",
            "This direct public-page feedback read path does not require `draft`"
          ]
        },
        {
          "type": "text_contains",
          "target": "eval:public-preview-feedback-direct-read:expected_output",
          "tokens": [
            "fetches the public preview URL",
            "comments_api_url directly",
            "without requiring draft"
          ]
        }
      ]
    }
  ]
}
