{
  "fixtures": [
    {
      "id": "phase3-headless-recovery-sequence",
      "title": "Headless page operations recover from DAEMON_OFFLINE with start-server only",
      "scenario_class": "hard-pass",
      "scope": "regression",
      "prompt": "Draft status says DAEMON_OFFLINE. Recover and then list pages.",
      "tags": ["recovery", "daemon-offline"],
      "nondeterminism": { "mode": "deterministic", "reruns": 1 },
      "assertions": [
        { "type": "trigger_decision", "expected": "activate" },
        {
          "type": "text_contains",
          "target": "skill",
          "tokens": ["draft status --json", "draft start-server", "draft page ls --json"]
        }
      ]
    },
    {
      "id": "phase3-removed-command-guidance",
      "title": "Removed command guidance stays explicit",
      "scenario_class": "hard-pass",
      "scope": "regression",
      "prompt": "Which Draft CLI commands should never be used now?",
      "tags": ["contract", "removed-surface"],
      "nondeterminism": { "mode": "deterministic", "reruns": 1 },
      "assertions": [
        {
          "type": "text_contains",
          "target": "skill",
          "tokens": [
            "draft daemon",
            "draft workspace ...",
            "draft open <path>",
            "draft public-comments ..."
          ]
        }
      ]
    },
    {
      "id": "phase3-secret-open-hosted-read",
      "title": "Secret Share reads skip daemon lifecycle",
      "scenario_class": "hard-pass",
      "scope": "regression",
      "prompt": "Read a Draft Secret Share link with a password.",
      "tags": ["secret-share", "hosted-read"],
      "nondeterminism": { "mode": "deterministic", "reruns": 1 },
      "assertions": [
        {
          "type": "text_contains",
          "target": "eval:secret-share-open-hosted-read:expected_output",
          "tokens": [
            "skips draft status",
            "draft secret open",
            "--password '1234' --json"
          ]
        }
      ]
    },
    {
      "id": "phase4-review-loop-retired",
      "title": "draft-review-loop is retired",
      "scenario_class": "hard-pass",
      "scope": "regression",
      "prompt": "Use draft-review-loop to open a local markdown file in Draft.",
      "tags": ["workflow", "retired"],
      "nondeterminism": { "mode": "deterministic", "reruns": 1 },
      "assertions": [
        {
          "type": "trigger_decision_for_skill",
          "skill": "draft-review-loop",
          "expected": "decline"
        }
      ]
    }
  ]
}
